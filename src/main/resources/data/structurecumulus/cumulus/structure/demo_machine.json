{
  "schemaVersion": 1,
  "id": "structurecumulus:demo_machine",
  "description": "a demonstration document: the full 5x5x4 machine - a stone plinth, a glazed housing, a copper core and a stair press head, one bay per stage",
  "bounds": [0, 0, 0, 5, 4, 5],
  "variants": {
    "group": "demo_machine",
    "members": [
      {
        "id": "structurecumulus:demo_machine",
        "label": "full"
      },
      {
        "id": "structurecumulus:demo_machine_compact",
        "label": "compact"
      }
    ]
  },
  "bays": [
    {
      "id": "plinth",
      "box": [0, 0, 0, 5, 1, 5],
      "coverage": "every_cell",
      "footprint": "none",
      "sharing": "shared",
      "description": "the stone plinth",
      "hint": "lay the outer ring first, then the four chiselled corners"
    },
    {
      "id": "housing",
      "boxes": [[0, 1, 0, 5, 2, 5]],
      "minus": [[1, 1, 1, 3, 2, 3]],
      "coverage": "every_cell",
      "footprint": "none",
      "sharing": "shared",
      "description": "the glazed housing",
      "hint": "raise the glass wall after the plinth is complete"
    },
    {
      "id": "core",
      "box": [1, 1, 1, 3, 2, 3],
      "coverage": "every_cell",
      "footprint": "none",
      "sharing": "shared",
      "description": "the copper core inside the housing",
      "hint": "drop the core into the empty middle"
    },
    {
      "id": "press",
      "box": [0, 3, 0, 5, 1, 5],
      "coverage": "every_cell",
      "footprint": "none",
      "sharing": "shared",
      "description": "the stair press head on top",
      "hint": "cap the housing, the hopper goes over the core"
    }
  ],
  "checks": [
    {
      "id": "plinth_corner_north_west",
      "bay": "plinth",
      "focus": {"kind": "occupant", "cell": [0, 0, 0]},
      "expect": {"kind": "block", "id": "minecraft:chiseled_stone_bricks"}
    },
    {
      "id": "plinth_corner_north_east",
      "bay": "plinth",
      "focus": {"kind": "occupant", "cell": [4, 0, 0]},
      "expect": {"kind": "block", "id": "minecraft:chiseled_stone_bricks"}
    },
    {
      "id": "plinth_corner_south_west",
      "bay": "plinth",
      "focus": {"kind": "occupant", "cell": [0, 0, 4]},
      "expect": {"kind": "block", "id": "minecraft:chiseled_stone_bricks"}
    },
    {
      "id": "plinth_corner_south_east",
      "bay": "plinth",
      "focus": {"kind": "occupant", "cell": [4, 0, 4]},
      "expect": {"kind": "block", "id": "minecraft:chiseled_stone_bricks"}
    },
    {
      "id": "plinth_floor",
      "bay": "plinth",
      "focus": {"kind": "bay"},
      "expect": {"kind": "each_cell", "element": {"kind": "block", "id": "minecraft:stone_bricks"}}
    },
    {
      "id": "housing_mullion_north",
      "bay": "housing",
      "focus": {"kind": "occupant", "cell": [2, 1, 0]},
      "expect": {"kind": "block", "id": "minecraft:iron_bars"}
    },
    {
      "id": "housing_mullion_south",
      "bay": "housing",
      "focus": {"kind": "occupant", "cell": [2, 1, 4]},
      "expect": {"kind": "block", "id": "minecraft:iron_bars"}
    },
    {
      "id": "housing_mullion_west",
      "bay": "housing",
      "focus": {"kind": "occupant", "cell": [0, 1, 2]},
      "expect": {"kind": "block", "id": "minecraft:iron_bars"}
    },
    {
      "id": "housing_mullion_east",
      "bay": "housing",
      "focus": {"kind": "occupant", "cell": [4, 1, 2]},
      "expect": {"kind": "block", "id": "minecraft:iron_bars"}
    },
    {
      "id": "housing_wall",
      "bay": "housing",
      "focus": {"kind": "bay"},
      "expect": {"kind": "each_cell", "element": {"kind": "block", "id": "minecraft:glass"}}
    },
    {
      "id": "core_lamp",
      "bay": "core",
      "focus": {"kind": "occupant", "cell": [2, 2, 2]},
      "expect": {"kind": "block", "id": "minecraft:sea_lantern"}
    },
    {
      "id": "core_body",
      "bay": "core",
      "focus": {"kind": "bay"},
      "expect": {"kind": "each_cell", "element": {"kind": "block", "id": "minecraft:copper_block"}}
    },
    {
      "id": "press_hopper",
      "bay": "press",
      "focus": {"kind": "occupant", "cell": [2, 3, 2]},
      "expect": {"kind": "block", "id": "minecraft:hopper"}
    },
    {
      "id": "press_cap",
      "bay": "press",
      "focus": {"kind": "bay"},
      "expect": {"kind": "each_cell", "element": {"kind": "block", "id": "minecraft:oak_stairs"}}
    }
  ]
}
