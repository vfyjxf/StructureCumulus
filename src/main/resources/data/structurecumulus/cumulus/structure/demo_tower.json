    },
    {
      "id": "shell_window_east",
      "bay": "shell",
      "focus": {"kind": "occupant", "cell": [4, 3, 2]},
      "expect": {"kind": "block", "id": "minecraft:glass"}
    },
    {
      "id": "shell_door_jamb_west_low",
